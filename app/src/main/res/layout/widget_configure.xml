<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/config_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="300dp"
        android:padding="24dp"
        android:background="@drawable/bg_widget_config">

        <ScrollView
            android:id="@+id/config_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:scrollbarStyle="outsideOverlay"
            app:layout_constraintHeight_max="400dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/confirm_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Icon/Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.AppCompat.Large"
                    android:drawableStart="@mipmap/ic_launcher"
                    android:drawablePadding="16dp"
                    android:text="Widget Options"
                    tools:ignore="UseCompatTextViewDrawableXml" />

                <!-- Left/Right Column Wrapper -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/columns_guideline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.5" />

                    <!-- Left Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toStartOf="@id/columns_guideline"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Background" />

                        <RadioGroup
                            android:id="@+id/background_options"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <RadioButton
                                android:id="@+id/option_white"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="White" />
                            <RadioButton
                                android:id="@+id/option_black"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Black" />
                            <RadioButton
                                android:id="@+id/option_liberty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Liberty" />
                        </RadioGroup>
                    </LinearLayout><!-- Left Column -->

                    <!-- Right Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/columns_guideline"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Text" />
                        <RadioGroup
                            android:id="@+id/text_options"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <RadioButton
                                android:id="@+id/text_white"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="White" />
                            <RadioButton
                                android:id="@+id/text_black"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Black" />
                            <RadioButton
                                android:id="@+id/text_liberty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Liberty" />
                        </RadioGroup>
                    </LinearLayout><!-- Right Column -->

                </androidx.constraintlayout.widget.ConstraintLayout><!-- Left/Right Column Wrapper -->

                <TextView
                    android:id="@+id/bg_opacity_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:labelFor="@id/opacity_percent"
                    android:text="@string/background_opacity" />
                <SeekBar
                    android:id="@+id/opacity_percent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:min="0"
                    android:max="100"
                    app:showSeekBarValue="true" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/show_update_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Last Updated Time" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/show_refresh_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Refresh Button" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/show_upload_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Upload Button" />

            </LinearLayout>
        </ScrollView>

        <!-- Save Widget Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/config_scroll"
            android:text="Save Widget Settings" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
