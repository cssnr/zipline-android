<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <PreferenceCategory
        android:key="widget_settings"
        android:title="Widget Settings">
        <ListPreference
            android:key="widget_text_color"
            android:title="Text Color"
            android:icon="@drawable/md_text_fields_24px"
            android:defaultValue="white"
            android:entries="@array/widget_color_entries"
            android:entryValues="@array/widget_color_values"
            tools:summary="White" />

        <ListPreference
            android:key="widget_bg_color"
            android:title="Background Color"
            android:icon="@drawable/md_palette_24px"
            android:defaultValue="black"
            android:entries="@array/widget_color_entries"
            android:entryValues="@array/widget_color_values"
            tools:summary="Black" />

        <androidx.preference.SeekBarPreference
            android:key="widget_bg_opacity"
            android:title="Background Opacity"
            android:defaultValue="35"
            android:icon="@drawable/md_texture_24px"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true" />

        <SwitchPreferenceCompat
            android:key="widget_show_update_time"
            android:title="Last Updated Time"
            android:summary="Show Updated Time on Widget"
            android:icon="@drawable/md_nest_clock_farsight_digital_24px"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="widget_show_refresh"
            android:title="Show Refresh Button"
            android:icon="@drawable/md_refresh_24px"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="widget_show_text"
            android:title="Show Text Button"
            android:icon="@drawable/md_text_snippet_24px"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="widget_show_upload"
            android:title="Show Upload Button"
            android:icon="@drawable/md_upload_24px"
            android:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
